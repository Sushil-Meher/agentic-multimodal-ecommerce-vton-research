POSTGRES_DB=sambalpuri_ai
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# sales agent LLM config (Phase 4)
# default is local Ollama, no API key needed - run `ollama pull qwen3:8b` first
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
# OLLAMA_BASE_URL=http://localhost:11434

